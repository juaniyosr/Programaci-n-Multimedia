<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_teclado">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guia_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.3" />

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/calc_display"
        android:gravity="center"
        android:text="@string/nombre_calculadora"
        android:textColor="@color/calc_boton"
        android:textSize="32sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guia_display"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ FILA 1: 7 8 9 x ============ -->
    <Button
        android:id="@+id/btn7"
        style="@style/BotonCalc"
        android:text="7"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintTop_toBottomOf="@id/guia_display"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn8" />

    <Button
        android:id="@+id/btn8"
        style="@style/BotonCalc"
        android:text="8"
        app:layout_constraintTop_toTopOf="@id/btn7"
        app:layout_constraintStart_toEndOf="@id/btn7"
        app:layout_constraintEnd_toStartOf="@id/btn9" />

    <Button
        android:id="@+id/btn9"
        style="@style/BotonCalc"
        android:text="9"
        app:layout_constraintTop_toTopOf="@id/btn7"
        app:layout_constraintStart_toEndOf="@id/btn8"
        app:layout_constraintEnd_toStartOf="@id/btnPor" />

    <Button
        android:id="@+id/btnPor"
        style="@style/BotonCalc"
        android:text="x"
        app:layout_constraintTop_toTopOf="@id/btn7"
        app:layout_constraintStart_toEndOf="@id/btn9"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ FILA 2: 4 5 6 - ============ -->
    <Button
        android:id="@+id/btn4"
        style="@style/BotonCalc"
        android:text="4"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintTop_toBottomOf="@id/btn7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn5" />

    <Button
        android:id="@+id/btn5"
        style="@style/BotonCalc"
        android:text="5"
        app:layout_constraintTop_toTopOf="@id/btn4"
        app:layout_constraintStart_toEndOf="@id/btn4"
        app:layout_constraintEnd_toStartOf="@id/btn6" />

    <Button
        android:id="@+id/btn6"
        style="@style/BotonCalc"
        android:text="6"
        app:layout_constraintTop_toTopOf="@id/btn4"
        app:layout_constraintStart_toEndOf="@id/btn5"
        app:layout_constraintEnd_toStartOf="@id/btnMenos" />

    <Button
        android:id="@+id/btnMenos"
        style="@style/BotonCalc"
        android:text="-"
        app:layout_constraintTop_toTopOf="@id/btn4"
        app:layout_constraintStart_toEndOf="@id/btn6"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ FILA 3: 1 2 3 + ============ -->
    <Button
        android:id="@+id/btn1"
        style="@style/BotonCalc"
        android:text="1"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintTop_toBottomOf="@id/btn4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn2" />

    <Button
        android:id="@+id/btn2"
        style="@style/BotonCalc"
        android:text="2"
        app:layout_constraintTop_toTopOf="@id/btn1"
        app:layout_constraintStart_toEndOf="@id/btn1"
        app:layout_constraintEnd_toStartOf="@id/btn3" />

    <Button
        android:id="@+id/btn3"
        style="@style/BotonCalc"
        android:text="3"
        app:layout_constraintTop_toTopOf="@id/btn1"
        app:layout_constraintStart_toEndOf="@id/btn2"
        app:layout_constraintEnd_toStartOf="@id/btnMas" />

    <Button
        android:id="@+id/btnMas"
        style="@style/BotonCalc"
        android:text="+"
        app:layout_constraintTop_toTopOf="@id/btn1"
        app:layout_constraintStart_toEndOf="@id/btn3"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ FILA 4: , 0 = (el "=" ocupa dos columnas) ============ -->
    <Button
        android:id="@+id/btnComa"
        style="@style/BotonCalc"
        android:text=","
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn0" />

    <Button
        android:id="@+id/btn0"
        style="@style/BotonCalc"
        android:text="0"
        app:layout_constraintTop_toTopOf="@id/btnComa"
        app:layout_constraintStart_toEndOf="@id/btnComa"
        app:layout_constraintEnd_toStartOf="@id/btnIgual" />

    <Button
        android:id="@+id/btnIgual"
        style="@style/BotonCalc"
        android:text="="
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintTop_toTopOf="@id/btnComa"
        app:layout_constraintStart_toEndOf="@id/btn0"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>